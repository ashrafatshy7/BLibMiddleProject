<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="900.0"
	style="-fx-background-color: #ffffff;"
	xmlns="http://javafx.com/javafx/23.0.1"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="gui.bounderies.TwoChartsController">
	<children>
		<!-- Title -->
		<Label layoutX="30.0" layoutY="20.0" text="Two Charts Report"
			style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e88e5;" />

		<!-- First Chart Section -->
		<VBox layoutX="38.0" layoutY="70.0" prefHeight="220.0"
			prefWidth="800.0"
			style="-fx-padding: 20; -fx-background-color: #f9f9f9; -fx-border-color: #e0e0e0; -fx-border-radius: 10; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 4);">
			<children>
				<Label text="Loan Report"
					style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #444;" />
				<BarChart fx:id="chartOne"
					style="-fx-background-color: transparent;">
					<xAxis>
						<CategoryAxis side="BOTTOM" />
					</xAxis>
					<yAxis>
						<NumberAxis side="LEFT" />
					</yAxis>
				</BarChart>
				<!-- Input Fields for First Chart -->
				<GridPane hgap="10" vgap="10" alignment="CENTER">
					<children>
						<Label text="Month:" GridPane.columnIndex="0"
							style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #444;" />
						<TextField fx:id="tfMonthOne" GridPane.columnIndex="1"
							promptText="Enter Month 1-12"
							style="-fx-background-color: #ffffff; -fx-border-color: #90caf9; -fx-border-radius: 5; -fx-padding: 5;" />
						<Label text="Year:" GridPane.columnIndex="2"
							style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #444;" />
						<TextField fx:id="tfYearOne" GridPane.columnIndex="3"
							promptText="Enter Year"
							style="-fx-background-color: #ffffff; -fx-border-color: #90caf9; -fx-border-radius: 5; -fx-padding: 5;" />
						<Button fx:id="btnGenerateOne" text="Generate"
							GridPane.columnIndex="4"
							style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-border-radius: 5; -fx-background-radius: 5; -fx-cursor: hand;" />
					</children>
				</GridPane>
			</children>
		</VBox>

		<!-- Second Chart Section -->
		<VBox layoutX="38.0" layoutY="320.0" prefHeight="220.0"
			prefWidth="800.0"
			style="-fx-padding: 20; -fx-background-color: #f9f9f9; -fx-border-color: #e0e0e0; -fx-border-radius: 10; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 4);">
			<children>
				<Label text="Subscribers Status Report"
					style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #444;" />
				<BarChart fx:id="chartTwo"
					style="-fx-background-color: transparent;">
					<xAxis>
						<CategoryAxis side="BOTTOM" />
					</xAxis>
					<yAxis>
						<NumberAxis side="LEFT" />
					</yAxis>
				</BarChart>
				<!-- Input Fields for Second Chart -->
				<GridPane hgap="10" vgap="10" alignment="CENTER">
					<children>
						<Label text="Month:" GridPane.columnIndex="0"
							style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #444;" />
						<TextField fx:id="tfMonthTwo" GridPane.columnIndex="1"
							promptText="Enter Month 1-12"
							style="-fx-background-color: #ffffff; -fx-border-color: #90caf9; -fx-border-radius: 5; -fx-padding: 5;" />
						<Label text="Year:" GridPane.columnIndex="2"
							style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #444;" />
						<TextField fx:id="tfYearTwo" GridPane.columnIndex="3"
							promptText="Enter Year"
							style="-fx-background-color: #ffffff; -fx-border-color: #90caf9; -fx-border-radius: 5; -fx-padding: 5;" />
						<Button fx:id="btnGenerateTwo" text="Generate"
							GridPane.columnIndex="4"
							style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-border-radius: 5; -fx-background-radius: 5; -fx-cursor: hand;" />
					</children>
				</GridPane>
			</children>
		</VBox>

		<!-- Back Button -->
		<Button fx:id="btnBack" layoutX="746.0" layoutY="20.0"
			text="Back"
			style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-border-radius: 5; -fx-background-radius: 5; -fx-cursor: hand;" />
	</children>
</AnchorPane>
