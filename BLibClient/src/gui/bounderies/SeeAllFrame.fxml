<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>

<AnchorPane prefHeight="399.0" prefWidth="669.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.bounderies.SeeAllFrameController">
   <children>
      <!-- Search Label -->
      <Label layoutX="14.0" layoutY="23.0" text="Search" />
      
      <!-- Search TextField with fx:id -->
      <TextField fx:id="searchTextField" layoutX="58.0" layoutY="19.0" prefWidth="200.0" />
      
      <!-- Back Button -->
      <Button fx:id="backButton" layoutX="603.0" layoutY="19.0" mnemonicParsing="false" onAction="#backBtn" stylesheets="@SeeAllFrame.css" text="Back" />
      
      <!-- ScrollPane containing FlowPane -->
      <ScrollPane fx:id="booksScrollPane" fitToHeight="true" fitToWidth="true" layoutY="51.0" prefHeight="348.0" prefWidth="669.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
         <content>
            <FlowPane fx:id="booksPanel" hgap="50.0" vgap="10">
                <padding>
                    <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
                </padding>
            </FlowPane>
         </content>
      </ScrollPane>
   </children>
</AnchorPane>
