<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>

<AnchorPane prefHeight="577.0" prefWidth="876.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <!-- Search Label -->
      <Label layoutX="73.0" layoutY="23.0" text="Search by name" />
      
      <!-- Search TextField with fx:id -->
      <TextField fx:id="searchByNameTextField" layoutX="184.0" layoutY="19.0" prefWidth="200.0" />
      
      <!-- Back Button -->
      <Button fx:id="backButton" layoutX="821.0" layoutY="19.0" mnemonicParsing="false" onAction="#backBtn" stylesheets="@SeeAllFrame.css" text="Back" />
      
      <!-- ScrollPane containing FlowPane -->
      <ScrollPane fx:id="booksScrollPane" fitToHeight="true" fitToWidth="true" layoutY="51.0" prefHeight="437.0" prefWidth="876.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
         <content>
            <FlowPane fx:id="booksPanel" hgap="50.0" vgap="10">
                <padding>
                    <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
                </padding>
            </FlowPane>
         </content>
      </ScrollPane>
      <Label layoutX="53.0" layoutY="59.0" text="Search by Category" />
      <Label layoutX="49.0" layoutY="94.0" text="Search by description" />
      <TextField fx:id="searchByDescriptionTextField" layoutX="184.0" layoutY="90.0" prefWidth="200.0" />
      <ComboBox fx:id="searchByCategory" layoutX="184.0" layoutY="55.0" prefHeight="26.0" prefWidth="200.0" />
      <RadioButton fx:id="nameRadio" layoutX="14.0" layoutY="19.0" mnemonicParsing="false" selected="true" />
      <RadioButton fx:id="categoryRadio" layoutX="14.0" layoutY="53.0" mnemonicParsing="false" />
      <RadioButton fx:id="descriptionRadio" layoutX="14.0" layoutY="88.0" mnemonicParsing="false" />
   </children>
</AnchorPane>
