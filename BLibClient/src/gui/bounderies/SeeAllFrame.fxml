<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(to bottom, #e3f2fd, #ffffff);" stylesheets="@SeeAllFrame.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <!-- Title Label -->
      <Label layoutX="20.0" layoutY="15.0" styleClass="title-label" text="Library Book Search" />
      
      <!-- Radio Buttons for Search Criteria -->
      <RadioButton fx:id="nameRadio" layoutX="20.0" layoutY="60.0" mnemonicParsing="false" selected="true" styleClass="radio-button" text="Search by Name" />
      <RadioButton fx:id="categoryRadio" layoutX="20.0" layoutY="100.0" mnemonicParsing="false" styleClass="radio-button" text="Search by Category" />
      <RadioButton fx:id="descriptionRadio" layoutX="20.0" layoutY="140.0" mnemonicParsing="false" styleClass="radio-button" text="Search by Description" />
      <TextField fx:id="searchByNameTextField" layoutX="194.0" layoutY="55.0" prefWidth="250.0" promptText="Type book name..." styleClass="text-field" />
      <ComboBox fx:id="searchByCategory" layoutX="194.0" layoutY="90.0" prefWidth="250.0" styleClass="combo-box" />
      <TextField fx:id="searchByDescriptionTextField" layoutX="194.0" layoutY="135.0" prefWidth="250.0" promptText="Type book description..." styleClass="text-field" />
      
      <!-- ScrollPane for Displaying Books -->
      <ScrollPane fx:id="booksScrollPane" fitToHeight="true" fitToWidth="true" layoutX="20.0" layoutY="200.0" prefHeight="350.0" prefWidth="860.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0">
         <content>
            <FlowPane fx:id="booksPanel" hgap="30.0" styleClass="bookBtn" vgap="20.0">
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>
            </FlowPane>
         </content>
      </ScrollPane>
      
      <!-- Back Button -->
      <Button fx:id="backButton" layoutX="780.0" layoutY="20.0" mnemonicParsing="false" onAction="#backBtn" styleClass="backButton" text="Back" />
   </children>
</AnchorPane>
