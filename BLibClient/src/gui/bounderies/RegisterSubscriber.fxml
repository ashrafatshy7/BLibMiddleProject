<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="650.0" prefWidth="876.0" stylesheets="@RegisterSubscriber.css" style="-fx-background-color: linear-gradient(to bottom, #e3f2fd, #ffffff);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.bounderies.RegisterSubscriberController">
    <children>
        <!-- Back Button -->
        <Button fx:id="backBtn" layoutX="750.0" layoutY="20.0" onAction="#goBack" text="Back" styleClass="modern-button" />

        <!-- Title -->
        <Label layoutX="277.0" layoutY="30.0" styleClass="title-label" text="Register New Subscriber" />

        <!-- Form Elements -->
        <Label layoutX="290.0" layoutY="100.0" styleClass="form-label" text="Read Card:" />
        <TextField fx:id="readCardField" layoutX="290.0" layoutY="120.0" styleClass="underlined-field" />
        <Label fx:id="readCardError" layoutX="290.0" layoutY="150.0" styleClass="error-label" visible="false" />

        <Label layoutX="290.0" layoutY="180.0" styleClass="form-label" text="Email:" />
        <TextField fx:id="emailField" layoutX="290.0" layoutY="200.0" styleClass="underlined-field" />
        <Label fx:id="emailError" layoutX="290.0" layoutY="230.0" styleClass="error-label" visible="false" />

        <Label layoutX="290.0" layoutY="260.0" styleClass="form-label" text="Password:" />
        <PasswordField fx:id="passwordField" layoutX="290.0" layoutY="280.0" styleClass="underlined-field" />
        <Label fx:id="passwordError" layoutX="290.0" layoutY="310.0" styleClass="error-label" visible="false" />

        <Label layoutX="290.0" layoutY="340.0" styleClass="form-label" text="Confirm Password:" />
        <PasswordField fx:id="confirmPasswordField" layoutX="290.0" layoutY="360.0" styleClass="underlined-field" />
        <Label fx:id="confirmPasswordError" layoutX="290.0" layoutY="390.0" styleClass="error-label" visible="false" />

        <Label layoutX="290.0" layoutY="420.0" styleClass="form-label" text="Username:" />
        <TextField fx:id="usernameField" layoutX="290.0" layoutY="440.0" styleClass="underlined-field" />
        <Label fx:id="usernameError" layoutX="290.0" layoutY="470.0" styleClass="error-label" visible="false" />

        <Label layoutX="290.0" layoutY="500.0" styleClass="form-label" text="Phone Number:" />
        <TextField fx:id="phoneField" layoutX="290.0" layoutY="520.0" styleClass="underlined-field" />
        <Label fx:id="phoneError" layoutX="290.0" layoutY="550.0" styleClass="error-label" visible="false" />

        <!-- Register Button -->
        <Button fx:id="registerBtn" layoutX="365.0" layoutY="590.0" onAction="#registerSubscriber" text="Register" styleClass="modern-button" />
    </children>
</AnchorPane>