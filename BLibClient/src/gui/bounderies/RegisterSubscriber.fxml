<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane maxHeight="-Infinity" minHeight="-Infinity" prefHeight="577.0" prefWidth="876.0" stylesheets="@RegisterSubscriber.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.bounderies.RegisterSubscriberController">
    <children>
        <Label layoutX="30.0" layoutY="35.0" text="ReadCard:" />
        <TextField fx:id="readCardField" layoutX="150.0" layoutY="35.0" prefHeight="26.0" prefWidth="243.0" />
        <Label fx:id="readCardError" layoutX="150.0" layoutY="65.0" style="-fx-font-size: 10px;" textFill="red" visible="false" />

        <Label layoutX="30.0" layoutY="100.0" text="Email:" />
        <TextField fx:id="emailField" layoutX="150.0" layoutY="100.0" prefHeight="26.0" prefWidth="243.0" />
        <Label fx:id="emailError" layoutX="150.0" layoutY="130.0" style="-fx-font-size: 10px;" textFill="red" visible="false" />

        <Label layoutX="30.0" layoutY="165.0" text="Password:" />
        <PasswordField fx:id="passwordField" layoutX="150.0" layoutY="165.0" prefHeight="26.0" prefWidth="243.0" />
        <Label fx:id="passwordError" layoutX="150.0" layoutY="195.0" style="-fx-font-size: 10px;" textFill="red" visible="false" />

        <Label layoutX="30.0" layoutY="230.0" text="Confirm Password:" />
        <PasswordField fx:id="confirmPasswordField" layoutX="150.0" layoutY="230.0" prefHeight="26.0" prefWidth="243.0" />
        <Label fx:id="confirmPasswordError" layoutX="150.0" layoutY="260.0" style="-fx-font-size: 10px;" textFill="red" visible="false" />

        <Label layoutX="30.0" layoutY="295.0" text="Username:" />
        <TextField fx:id="usernameField" layoutX="150.0" layoutY="295.0" prefHeight="26.0" prefWidth="243.0" />
        <Label fx:id="usernameError" layoutX="150.0" layoutY="325.0" style="-fx-font-size: 10px;" textFill="red" visible="false" />

        <Label layoutX="30.0" layoutY="360.0" text="Phone Number:" />
        <TextField fx:id="phoneField" layoutX="150.0" layoutY="360.0" prefHeight="26.0" prefWidth="243.0" />
        <Label fx:id="phoneError" layoutX="150.0" layoutY="390.0" style="-fx-font-size: 10px;" textFill="red" visible="false" />

        <Button fx:id="registerBtn" layoutX="150.0" layoutY="450.0" onAction="#registerSubscriber" prefHeight="26.0" prefWidth="120.0" text="Register" />
        <Button fx:id="backBtn" layoutX="290.0" layoutY="450.0" onAction="#goBack" prefHeight="26.0" prefWidth="120.0" text="Back" />
    </children>
</AnchorPane>
