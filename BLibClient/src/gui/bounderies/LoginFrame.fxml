		<Label fx:id="EmailAddresserrorLabel" layoutX="520.0" layoutY="266.0" style="-fx-text-fill: red; -fx-font-size: 14px;" text="Incorrect email address" visible="false" />

		<!-- Buttons: Styled and properly positioned -->
		<Button fx:id="loginButton" layoutX="597.0" layoutY="416.0" mnemonicParsing="false" onAction="#handleLoginButtonAction" prefHeight="50.0" prefWidth="100.0" style="-fx-background-color: #2e3a59; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-font-size: 18px;" text="Login" />

	</children>
</AnchorPane>