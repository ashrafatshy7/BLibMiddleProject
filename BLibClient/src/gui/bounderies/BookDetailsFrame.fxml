<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="399.0" prefWidth="699.0" stylesheets="@BookDetailsFrame.css" style="-fx-background-color: linear-gradient(to bottom, #e3f2fd, #ffffff);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.bounderies.BookDetailsFrameController">
	<children>
		<ImageView fx:id="image" fitHeight="182.0" fitWidth="115.0" layoutX="14.0" layoutY="14.0" pickOnBounds="true" preserveRatio="true" />
		<Label fx:id="title" layoutX="182.0" layoutY="20.0" styleClass="title-label" />
		<Label fx:id="author" layoutX="141.0" layoutY="70.0" styleClass="info-label" text="Author: " />
		<Label fx:id="barcode" layoutX="141.0" layoutY="95.0" styleClass="info-label" text="Barcode: " />
		<Label fx:id="category" layoutX="140.0" layoutY="120.0" styleClass="info-label" text="Category:" />
		<Label layoutX="14.0" layoutY="200.0" styleClass="description-label" text="Description: " />
		<Label fx:id="shelfReturnDate" layoutX="140.0" layoutY="170.0" styleClass="info-label" />
		<Label fx:id="isAvailable" layoutX="140.0" layoutY="145.0" styleClass="info-label" text="Is Available: " />
		<Label fx:id="description" alignment="TOP_LEFT" layoutX="14.0" layoutY="223.0" prefHeight="168.0" prefWidth="676.0" styleClass="description-box" />
		<Button layoutX="609.0" layoutY="19.0" onAction="#backBtn" styleClass="modern-button" text="Back" />
		<Button fx:id="order" layoutX="555.0" layoutY="151.0" onAction="#orderBtn" styleClass="order-button" text="Order" />
		<Label fx:id="bookOrdered" layoutX="539.0" layoutY="182.0" styleClass="ordered-label" text="You ordered this book!" textFill="#b3271f" />
	</children>
</AnchorPane>
