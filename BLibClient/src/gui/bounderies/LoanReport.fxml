<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.bounderies.LoanReportController">
   <children>
      <Label layoutX="30.0" layoutY="20.0" text="Generate Loan Report" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e88e5;" />
      
      <!-- Larger BarChart Container -->
      <VBox layoutX="50.0" layoutY="100.0" prefHeight="400.0" prefWidth="800.0" style="-fx-padding: 20; -fx-background-color: #f9f9f9; -fx-border-color: #e0e0e0; -fx-border-radius: 10; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 4);">
         <children>
            <BarChart fx:id="barChart" style="-fx-background-color: transparent;">
              <xAxis>
                <CategoryAxis side="BOTTOM" />
              </xAxis>
              <yAxis>
                <NumberAxis side="LEFT" />
              </yAxis>
            </BarChart>
         </children>
      </VBox>
      
      <!-- Input Fields and Generate Button -->
      <TextField fx:id="tfMonth" layoutX="70.0" layoutY="520.0" prefHeight="35.0" prefWidth="150.0" promptText="Enter Month 1-12" 
                 style="-fx-background-color: #ffffff; -fx-border-color: #90caf9; -fx-border-radius: 5; -fx-padding: 5;" />
      <TextField fx:id="tfYear" layoutX="240.0" layoutY="520.0" prefHeight="35.0" prefWidth="150.0" promptText="Enter Year" 
                 style="-fx-background-color: #ffffff; -fx-border-color: #90caf9; -fx-border-radius: 5; -fx-padding: 5;" />
      <Button fx:id="btnGenerate" layoutX="410.0" layoutY="520.0" mnemonicParsing="false" onAction="#btnGenerateClicked" text="Generate" 
              style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-border-radius: 5; -fx-background-radius: 5; -fx-cursor: hand;" 
              onMouseEntered="btnGenerate.setStyle('-fx-background-color: #66bb6a; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-border-radius: 5; -fx-background-radius: 5; -fx-cursor: hand;');" 
              onMouseExited="btnGenerate.setStyle('-fx-background-color: #4caf50; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-border-radius: 5; -fx-background-radius: 5;');" />
      
      <!-- Back Button -->
      <Button fx:id="btnBack" layoutX="760.0" layoutY="30.0" mnemonicParsing="false" onAction="#btnBackClicked" text="Back" 
              style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-border-radius: 5; -fx-background-radius: 5; -fx-cursor: hand;" 
              onMouseEntered="btnBack.setStyle('-fx-background-color: #e57373; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-border-radius: 5; -fx-background-radius: 5; -fx-cursor: hand;');" 
              onMouseExited="btnBack.setStyle('-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-border-radius: 5; -fx-background-radius: 5;');" />
   </children>
</AnchorPane>
